<li class="item flexrow" data-entry-uuid="{{entry.uuid}}" data-type="Item">
    <div class="image">
        <img class="" src="{{entry.img}}" title="{{entry.name}}" width="40" height="40" loading="lazy"/>
    </div>
    <div class="name">
        <a class="item-link">{{entry.name}}</a>
    </div>
    <div class="tags">
        {{#if entry.ruleVersion}}
            {{#if (eq entry.ruleVersion.status "resolved")}}
                <span class="tag rule-version" title="{{entry.ruleVersion.sourceCitation}}">{{entry.ruleVersion.versionLabel}}</span>
                <span class="tag rule-source">{{entry.ruleVersion.sourceEdition}} — {{localize entry.ruleVersion.sourceStatusLabel}}</span>
            {{else}}
                <span class="tag rule-version-unresolved">{{localize entry.ruleVersion.statusLabel}}</span>
            {{/if}}
        {{/if}}
        {{#if entry.class}}<span class="tag class class-{{entry.class}}" title="{{entry.class}}">{{entry.classPretty}}</span>{{/if}}
        {{#each entry.prerequisites as |entry|}}
            {{#if entry.tier}}
                <span class="tag skill-{{toLowerCase entry.tier}}" title="{{entry.label}}">{{entry.label}}</span>
            {{else if entry.feat}}
                <span class="tag feat" title="{{entry.label}}">{{entry.label}}</span>
            {{else}}
                <span class="tag" title="{{entry.label}}">{{entry.label}}</span>
            {{/if}}
        {{/each}}
    </div>
</li>
